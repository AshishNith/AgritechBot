ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: model for follow-up suggestions and history summaries (defaults to ANTHROPIC_MODEL)
ANTHROPIC_SUGGESTIONS_MODEL=
SARVAM_API_KEY=your_sarvam_api_key_here
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/anaaj_ai
JWT_SECRET=replace_with_32_char_secret_or_longer
JWT_EXPIRES_IN=7d
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@anaaj.ai
ADMIN_PASSWORD=Admin@123
FAST2SMS_KEY=your_fast2sms_api_key_here

# Email (Nodemailer - Gmail SMTP)
SMTP_EMAIL=your_gmail@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password_here
CONTACT_NOTIFICATION_EMAIL=your_notification_email@gmail.com

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
